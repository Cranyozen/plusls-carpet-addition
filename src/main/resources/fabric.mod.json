  "authors": [
    {
      "name": "plusls",
      "contact": {
        "homepage": "https://github.com/plusls"
      }
    }
  ],
  "contact": {
    "homepage": "https://blog.plugls.com",
    "issues": "https://github.com/plusls/plusls-carpet-addition/issues",
    "sources": "https://github.com/plusls/plusls-carpet-addition"
  },
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.plusls.carpet.PluslsCarpetAddition"
